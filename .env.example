# Tracked placeholder template only. No Client integration variable is browser-public.
# Local development: ignored axs_client/.env.local
# Hosted client: Vercel Preview/Production server environment settings

# Server-only Operations origin used only by the allowlisted /api/axs BFF.
AXS_ADMIN_API_ORIGIN=https://ops.example.invalid
# Exact canonical Client origin used for same-site mutation validation.
PUBLIC_APP_ORIGIN=https://client.example.invalid
# Matching server-only credential installed independently in Client and Admin.
AXS_CLIENT_PROXY_SECRET=GENERATE_IN_SECRET_STORE
# Server-only source token for the same-origin /api/operational-events proxy.
# Never prefix it with NEXT_PUBLIC_ and never put a real value in this template.
OBSERVABILITY_INGEST_TOKEN=FILL_IN_SECRET_STORE
